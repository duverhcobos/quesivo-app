{
    // Configuraciones de Perfiles para la Arquitectura S.O.L.I.D.
    // Usa el panel inferior derecho de VS Code para cambiar rápidamente entre Entornos.
    //
    // 🔒 SEGURIDAD: los tokens NUNCA se escriben en este archivo (está versionado
    // en git). Se leen de variables de entorno del sistema operativo:
    //   API_TOKEN_DEV, API_TOKEN_STG, API_TOKEN_PROD
    // Windows (PowerShell, una sola vez por máquina):
    //   [Environment]::SetEnvironmentVariable('API_TOKEN_DEV', 'tu-token', 'User')
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Solid DEV (Entorno Local)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=ENV=dev",
                "--dart-define=API_TOKEN=${env:API_TOKEN_DEV}",
                // Web OAuth client ID de Google Cloud (propuesta 70) —
                // misma convención que API_TOKEN: el valor vive en una
                // variable de entorno del SO, no en el archivo.
                "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
            ]
        },
        {
            "name": "Solid DEV (Dispositivo Físico)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=ENV=dev",
                // IP LAN de la PC donde corre el backend local — ajustar si
                // cambia por DHCP (ipconfig → IPv4 del adaptador Wi-Fi).
                // El backend debe escuchar en 0.0.0.0 (NestJS default).
                "--dart-define=API_URL=http://192.168.1.6:3000",
                "--dart-define=API_TOKEN=${env:API_TOKEN_DEV}",
                "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
            ]
        },
        {
            "name": "Solid STG (Servidor Pruebas)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=ENV=stg",
                "--dart-define=API_TOKEN=${env:API_TOKEN_STG}",
                "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
            ]
        },
        {
            "name": "Solid PROD (Modo Release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release", // Simula entorno real optimizado compilado
            "args": [
                "--dart-define=ENV=prod",
                "--dart-define=API_TOKEN=${env:API_TOKEN_PROD}",
                "--dart-define=GOOGLE_SERVER_CLIENT_ID=${env:GOOGLE_SERVER_CLIENT_ID}"
            ]
        }
    ]
}
